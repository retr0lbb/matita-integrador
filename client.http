# ==== ACCOUNTS ====
### create account
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "userId": "76c3bedb-7448-4dee-b8f0-535a265a6c5e"
}

### get unique account
GET {{baseUrl}}/accounts/030ca590-d7f2-45ce-aa5c-8dee5745adc3

### list all accounts
GET {{baseUrl}}/accounts

### delete account with google
DELETE {{baseUrl}}/accounts/16757e91-9bfa-4019-a768-333294e2155e

### import from google
POST {{baseUrl}}/accounts/import/google
Content-Type: application/json

{
  "orgPath": "/Integrador-teste/Maplebear Jujutsu Tokio"
}

### CREATE INSTITUTION
POST {{baseUrl}}/institution
Content-Type: application/json

{
  "name": "Maplebear"
}

### create unit
POST {{baseUrl}}/unit
Content-Type: application/json

{
  "institutionId": "342ceae5-749c-45ea-88e0-2ebca2aa0b34",
  "alias": "Maplebear Jujutsu Tokio",
  "address": null
}

### LINK UNIT WITH GOOGLE
POST {{baseUrl}}/unit/bef0784f-d46b-4e9f-b589-c0436492c3d8/link/google

# ===== CLASSROOMS ======
### create classroom
POST {{baseUrl}}/unit/bef0784f-d46b-4e9f-b589-c0436492c3d8/classroom
Content-Type: application/json

{
  "title": "Jujutsu 2° Kyoto",
  "ownerAccountId": "cd3bba69-f243-4e62-aa00-f63e02637467"
}

### List classrooms
GET {{baseUrl}}/unit/bef0784f-d46b-4e9f-b589-c0436492c3d8/classroom

### archive classroom
DELETE {{baseUrl}}/classroom/21517cc5-bd2b-41ec-a518-dc0b09d12b37

